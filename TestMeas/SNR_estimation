    RSSI[3] = station[3]["RSSI"]

    RSSI[0] = maxbeam(RSSI[0])
    RSSI[1] = maxbeam(RSSI[1])
    RSSI[2] = maxbeam(RSSI[2])
    RSSI[3] = maxbeam(RSSI[3])

    complete_rssi = np.concatenate(RSSI)
